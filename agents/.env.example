# ── Gemini via Vertex AI (uses your Google Cloud credits) ──────────────────────
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Your Google Cloud project ID (NOT the display name).
# Find it at console.cloud.google.com — shown in parentheses in the top bar.
GOOGLE_CLOUD_PROJECT=your_project_id_here

# Vertex AI region. Keep this "global": Gemini 3.x models are served only from
# the global endpoint — regional endpoints (e.g. us-central1) return 404 NOT_FOUND.
GOOGLE_CLOUD_LOCATION=global

# ── Authentication (pick ONE) ───────────────────────────────────────────────────
# Option A — your Google account via gcloud (easiest for local dev):
#   Run once in terminal: gcloud auth application-default login
#   Install gcloud if needed: winget install Google.CloudSDK
#   Leave GOOGLE_APPLICATION_CREDENTIALS unset.
#
# Option B — service account JSON key file (no gcloud needed):
#   Cloud Console → IAM → Service Accounts → hodari-gemini → Keys → Add Key → JSON
#   Download the file, then set the path below:
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\User\Documents\Map_Me\agents\hodari-gemini-key.json

# NOTE: The Gemini API key you created in Cloud Console is NOT used here.
# Vertex AI authenticates via your Google account (ADC) or a service account key file.
# That key will be used later when deploying to Cloud Run.

# Model to use for all agents (primary).
GEMINI_MODEL=gemini-3.5-flash

# ── LLM fallback cascade (429 / quota) ───────────────────────────────────────
# When Gemini hits RESOURCE_EXHAUSTED, ADK FallbackModel tries these in order.
# Same keys as client/.env.local — duplicate them here because the agent is a
# separate Python process and does not read the Next.js env file.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Optional: Gemini Developer API key for the plain text-completion helper
# (the main agents still use Vertex via ADC when GOOGLE_GENAI_USE_VERTEXAI=TRUE).
# GEMINI_API_KEY=
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# Seconds to skip Gemini after a 429 (default 60).
# HODARI_GEMINI_COOLDOWN_S=60

# ── Google Maps — Agent (Grounding Lite) key ────────────────────────────────────
# Dedicated, least-privilege server key for the agent ONLY. Restrict it to a
# single API: Maps Grounding Lite (mapstools.googleapis.com). No application
# restriction needed (Cloud Run egress IPs are dynamic) — keep it secret.
# This is SEPARATE from the frontend's browser/server Maps keys (see
# client/.env.local.example) so each can be rotated without affecting the others.
GOOGLE_MAPS_API_KEY=your_agent_grounding_lite_key_here
# Places API (New) text search. The Grounding Lite key above cannot call
# places.googleapis.com. Set the Next.js server key (Places API enabled),
# or leave this unset locally and the agent reads client/.env.local.
# GOOGLE_MAPS_SERVER_KEY=your_server_maps_key_here
# Browser-restricted keys reject server calls with an empty Referer.
# Defaults to http://localhost:3000/ when unset.
# PLACES_HTTP_REFERER=http://localhost:3000/

# NOTE: web_search uses Gemini's Google Search grounding via Vertex AI (ADC) —
# it needs NO separate API key.

# ── MongoDB Atlas ───────────────────────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hodari

# ── MongoDB MCP Server ──────────────────────────────────────────────────────
# Start the MCP server first (see CLAUDE.md dev commands), then set this URL.
# The MCP server reads MONGODB_URI above as MDB_MCP_CONNECTION_STRING.
MONGODB_MCP_URL=http://localhost:3100/mcp

# ── Community MCP Server (opt-in) ────────────────────────────────────────────
# Read-only community tools (profiles, shared pins, reviews, taste profiles)
# for personalized recommendations. Start it from agents/ with:
#   .venv\Scripts\python.exe -m community_mcp.server
# It connects to Mongo directly via MONGODB_URI above (or
# MDB_MCP_CONNECTION_STRING) and serves streamable-http MCP on port 3200.
# The agent only loads these tools when COMMUNITY_MCP_URL is set (or
# COMMUNITY_MCP_ENABLED=1 for the default localhost URL) — leaving both unset
# keeps the classic setup unchanged. Privacy: this server has NO access to the
# messages/conversations collections (see agents/community_mcp/README.md).
# COMMUNITY_MCP_URL=http://localhost:3200/mcp
# COMMUNITY_MCP_ENABLED=1
# COMMUNITY_MCP_PORT=3200

# ── Performance profiling (Phase B) ─────────────────────────────────────────
# Log a HODARI PROFILE table (per-LLM tokens/latency + per-tool timing) after
# each agent run. Set to 0 in production if logs are too noisy.
HODARI_PROFILING=1

# ── Token-cost caching (#8) ──────────────────────────────────────────────────
# Gemini context/prompt caching via Vertex AI (ADK ContextCacheConfig).
# Caches agent system instructions + tool definitions at the Vertex layer so
# only variable content (user message + session state) is billed per call.
# Requires GOOGLE_GENAI_USE_VERTEXAI=TRUE — set to 0 to disable.
HODARI_CONTEXT_CACHE=1

# LIST_DISCOVERY response cache TTL in seconds (default: 1200 = 20 min).
# Set to 0 to disable the in-process response cache.
# HODARI_RESPONSE_CACHE_TTL=1200

# ── Per-agent Cloud Run split (Phase 2) ──────────────────────────────────────
# Hodari can run as ONE service (all agents in-process, the MVP default) or as
# FOUR independent Cloud Run services. The split is entirely config-driven.
#
# AGENT_SERVICE selects which agent a container serves (used by the Dockerfile
# CMD: `adk api_server services/${AGENT_SERVICE}`). One of:
#   orchestrator | planner | explorer | itinerary
# AGENT_SERVICE=orchestrator
#
# The orchestrator runs the REMOTE (HTTP fan-out) pipeline only when all three
# leaf URLs are set; otherwise it falls back to the in-process pipeline. So
# leaving these unset = classic single-service MVP mode (nothing changes).
# PLANNER_SERVICE_URL=https://hodari-planner-xxxx.a.run.app
# EXPLORER_SERVICE_URL=https://hodari-explorer-xxxx.a.run.app
# ITINERARY_SERVICE_URL=https://hodari-itinerary-xxxx.a.run.app
#
# Service-to-service auth for the HTTP calls between orchestrator and leaves:
#   iam  — attach a Google OIDC ID token (audience = target URL). Default when
#          running on Cloud Run (K_SERVICE is set). Leaf services should be
#          deployed --no-allow-unauthenticated and grant the orchestrator's
#          service account roles/run.invoker.
#   none — no Authorization header (local dev, or --allow-unauthenticated leaves).
# HODARI_SERVICE_AUTH=iam

# Drop vector hits below this cosine score. Category matches do not need it.
# MIN_VECTOR_SCORE=0.6
