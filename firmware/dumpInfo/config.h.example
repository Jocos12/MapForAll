#pragma once

// =============================================================================
// MapForAll — ESP32 RFID attendance reader — configuration
// =============================================================================

// ---------------------------------------------------------------------------
// 1) WiFi — same network as the PC running the MapForAll backend
// ---------------------------------------------------------------------------
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

#define WIFI_TIMEOUT_MS 15000

// ---------------------------------------------------------------------------
// 2) MapForAll backend URL
// ---------------------------------------------------------------------------
#define SERVER_URL \
  "http://192.168.1.21:3001/api/business/attendance/scan"

// ---------------------------------------------------------------------------
// 3) Per-business RFID API key (header: X-RFID-API-KEY)
// ---------------------------------------------------------------------------
#define RFID_API_KEY    "YOUR_RFID_API_KEY"

// ---------------------------------------------------------------------------
// 4) Device ID
// ---------------------------------------------------------------------------
#define DEVICE_ID       "MAPFORALL_COFFEESHOP_01"

// ---------------------------------------------------------------------------
// 5) Timeouts & debounce (ms)
//    One tap = one POST. HTTP_TIMEOUT_MS is the per-attempt ceiling (one retry).
// ---------------------------------------------------------------------------
#define HTTP_TIMEOUT_MS 3000
#define DEBOUNCE_MS     1500

// MFRC522 pins
#define RFID_SS_PIN     5
#define RFID_RST_PIN    22

// Optional feedback. -1 disables the pin (no blink, no beep).
#define LED_OK_PIN      -1
#define LED_ERR_PIN     -1
#define BUZZER_PIN      -1
